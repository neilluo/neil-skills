<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.neil.kb-evolve</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/neil/Desktop/neilskills/neil-qoder-kb/scripts/kb-evolve.sh</string>
    </array>

    <!-- 每天 09:30 执行（开机后第一时间） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- 日志输出 -->
    <key>StandardOutPath</key>
    <string>/Users/neil/Desktop/neilskills/neil-qoder-kb/logs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/neil/Desktop/neilskills/neil-qoder-kb/logs/launchd-stderr.log</string>

    <!-- 环境变量 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/neil</string>
        <key>PATH</key>
        <string>/Users/neil/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- 如果错过了执行时间（关机），开机后补执行一次 -->
    <key>StartInterval</key>
    <integer>86400</integer>
</dict>
</plist>
